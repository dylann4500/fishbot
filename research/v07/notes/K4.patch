+{
+echo "### K4 commit gate -- MIRROR (self-play), 400 deals x 2 rotations, seed 31, 2 threads"
+echo
+echo "--- reference: v06 mirror ---"
+./fish7 pathology --a=v06 --b=v06 --games=400 --rotations=2 --seed=31 --threads=2
