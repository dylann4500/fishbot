+    echo "$R" | python3 -c "import sys,json; d=json.load(sys.stdin); print('   edge %+.2f  ci [%+.2f, %+.2f]  n=%d  %.1f g/s' % (100*d['winRateA']-50, 100*d['ci'][0]-50, 100*d['ci'][1]-50, d['games'], d['gamesPerSec']))"
