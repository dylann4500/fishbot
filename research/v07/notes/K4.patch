++// ------------------------------------------------------------------- config
++struct SideConfig {
++  std::string specA = "v06";     // the team under certification (three copies)
++  std::string specB = "v06";     // the fixed opponent
++  int games = 200;               // deals
++  int rotations = 2;
++  int threads = 0;
++  uint64_t seed = 7030001;
++  Rules rules;
++  bool s3 = true, s4 = true, s5 = true, s6 = true;
