++  Rng rng(0x5A1Dull);
++  for (int r = 0; r < B; r++) {
++    double acc = 0;
++    for (size_t i = 0; i < n; i++) acc += d[rng.u32(uint32_t(n))];
++    draws[size_t(r)] = acc / double(n);
++  }
++  std::sort(draws.begin(), draws.end());
++  lo = draws[size_t(0.025 * B)]; hi = draws[size_t(0.975 * B)];
++}
